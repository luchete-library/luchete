extends "res://tests/render.gd"

const OUTPUT := "dori_discovery_20261114/"

func start_rubbing() -> void:
	game.state=game.State.new()
	game.state.accept_mission("dori")
	game.state.chapter_steps.dori=1
	game.state.marked_actions.append("dori")
	game.state.dori_notes=["practice","report","stone_compare","sleeper"]
	game._open_story(4,"journal")
	game._turn_story()
	await repaint()

func reopen() -> void:
	await reader_key(KEY_ESCAPE)
	var shared: bool=game.book_discovery.active(game)
	check((game.book_discovery.paused if shared else game.dori_rubbing.paused) and game.mode=="chapter","Escape opens the menu instead of leaving the book")
	await button("discovery_leave" if shared else "rubbing_leave")
	var restored=game.State.new()
	check(restored.apply_data(JSON.parse_string(JSON.stringify(game.state.to_data()))),"discovery survives a real JSON round trip")
	game.state=restored
	game._open_story(4,"journal")
	game._turn_story()
	await repaint()

func next_record() -> void:
	await elapse(.01)
	await finish_story_record()

func run() -> void:
	root.size=Vector2i(1280,800)
	game=PreviewGame.new()
	root.add_child(game)
	await process_frame
	game.set_process(false)
	game.audio_enabled=false
	game.save_available=false
	await start_rubbing()
	var r=game.dori_rubbing
	check(game.objects.size()==3,"one memory stone and two optional comparisons")
	check(game.ui_regions.size()==2 and game.buttons.size()==1,"field has only a question, compact footer and menu")
	await capture(OUTPUT+"01_field")
	# Look at either ordinary stone first. No mandatory checklist or history changes.
	for i in [1,0]:
		await tap(game.WORLD_OFFSET+r.SAMPLES[i].pos*game.WORLD_SCALE)
		await finish_walk()
		check(not r.observation.is_empty() and not game.chapter_question,"optional observation stays on the map")
	check(game.state.dori_notes.size()==4,"optional comparisons never gate the official event")
	await capture(OUTPUT+"02_observation")
	await tap(game.WORLD_OFFSET+r.rock(game)*game.WORLD_SCALE)
	check(game.pending_object=="clue_rubbing","stone click walks the fan to the tool position")
	await finish_walk()
	await elapse(.5)
	check(r.phase==r.Phase.RUB,"close inspection starts at the stone")
	await hold_arrow(KEY_E,.45)
	var charcoal: float=r.charcoal
	await reader_key(KEY_ESCAPE)
	check(game.mode=="chapter" and r.phase==r.Phase.FIELD and not game.chapter_question,"Escape returns to the map from the tool")
	await elapse(.5)
	await reader_key(KEY_E)
	await elapse(.5)
	check(is_equal_approx(r.charcoal,charcoal),"closing the tool does not erase the partial impression")
	await capture(OUTPUT+"03_rubbing")
	await hold_arrow(KEY_E,r.RUB_TIME)
	check(r.has_print(game) and not r.held_by_ete(game),"rubbing reveals the outline before Ete picks up Dori")
	await elapse(r.TO_STONE+r.LIFT+.3)
	await capture(OUTPUT+"04_carry")
	var feet: Vector2=r.ete_feet(game)
	await reader_key(KEY_ESCAPE)
	await elapse(10)
	check(r.ete_feet(game).is_equal_approx(feet),"pause freezes Ete rather than skipping her departure")
	await reader_key(KEY_ESCAPE)
	await reopen()
	check(r.has_print(game) and r.held_by_ete(game),"saved impression resumes with Ete's stone")
	await tap(game.WORLD_OFFSET+r.rock(game)*game.WORLD_SCALE)
	await finish_walk()
	await elapse(.5)
	check(r.phase==r.Phase.ALIGN,"approaching Ete opens the paper comparison")
	await reader_key(KEY_E)
	check(not "print3" in game.state.dori_notes,"pressing confirm cannot replace comparing the outline")
	await capture(OUTPUT+"05_align")
	await hold_arrow(KEY_D,.35)
	await hold_arrow(KEY_W,.13)
	check(r.phase==r.Phase.MATCHED,"keyboard alignment snaps near the outline without confirmation")
	await elapse(.25)
	await capture(OUTPUT+"06_discovery")
	await reopen()
	check(r.phase==r.Phase.MATCHED,"completed old-style notes resume the discovery instead of a dead-end record")
	await next_record()
	await elapse(r.FADE_TIME)
	await repaint()
	check(game.state.debut_scene("dori")==3 and not game.chapter_question,"discovery continues directly to the library")
	check(not game.state.chapter_routes.has("dori") and not game.state.page_complete,"automatic continuation cannot finish the whole book")
	await capture(OUTPUT+"07_library")
	await elapse(20)
	check(game.state.debut_scene("dori")==3 and not game.state.page_complete,"continuation advances exactly once")
	# The mouse has the same result, including forgiving off-centre placement.
	await start_rubbing()
	await tap(game.WORLD_OFFSET+r.rock(game)*game.WORLD_SCALE)
	await finish_walk()
	await elapse(.5)
	var center: Vector2=game.WORLD_OFFSET+r.rock(game)*game.WORLD_SCALE
	var span:=Vector2(16,0)*float(game.WORLD_SCALE)
	await swipe(center-span,center+span)
	check(r.charcoal>0 and r.charcoal<1,"mouse strokes immediately reveal a partial impression")
	await swipe(center+span,center-span)
	await swipe(center-span,center+span)
	check(r.has_print(game),"mouse rubbing completes without a key or result button")
	await elapse(r.WALK_TIME+.1)
	await tap(game.WORLD_OFFSET+r.rock(game)*game.WORLD_SCALE)
	await finish_walk()
	await elapse(.5)
	var target: Vector2=game.WORLD_OFFSET+r.rock(game)*game.WORLD_SCALE
	await swipe(target+r.offset*game.WORLD_SCALE,target+Vector2(5,-2)*game.WORLD_SCALE)
	check(r.phase==r.Phase.MATCHED,"mouse placement tolerates an imperfect match")
	await next_record()
	check(game.state.debut_scene("dori")==3,"mouse path also continues automatically")
	# Old saved routes and replays use the same completion, without changing the campaign.
	await start_rubbing()
	game.state.dori_notes.append_array(["print1","print2","print3"])
	game.state.open_chapter_route("dori")
	game._enter_chapter("dori")
	check(r.phase==r.Phase.MATCHED and game._find_object("story_path").is_empty(),"legacy continuation does not recreate the removed exit chore")
	await next_record()
	check(game.state.debut_scene("dori")==3 and not game.state.chapter_routes.has("dori"),"legacy continuation consumes its checkpoint")
	await start_rubbing()
	game.replay_progress=game.State.new()
	game.replay_progress.apply_data(JSON.parse_string(JSON.stringify(game.state.to_data())))
	game.replay_progress.dori_notes.append_array(["print1","print2","print3"])
	var campaign: Dictionary=game.state.to_data().duplicate(true)
	game._enter_chapter("dori")
	await next_record()
	check(game.replay_progress.debut_scene("dori")==3 and game.state.to_data()==campaign,"replay advances only its isolated progress")
	# The user-facing scene picker must not cover the new menu or swallow this transition.
	game.queue_free()
	await process_frame
	game=load("res://tests/story_scene_playtest.gd").new()
	root.add_child(game)
	game.set_process(false)
	game.audio_enabled=false
	game.start_scene(1)
	await repaint()
	check(game.buttons.size()==1 and game.buttons[0].id=="rubbing_pause","scene picker preserves the campaign's minimal UI")
	await button("rubbing_pause")
	check(game.dori_rubbing.paused and game.mode=="chapter","scene picker does not intercept the pause button")
	await button("rubbing_resume")
	game.state.dori_notes.append_array(["print1","print2","print3"])
	game._enter_chapter("dori")
	await next_record()
	check(game.mode=="chapter" and game.state.debut_scene("dori")==3,"scene test also shows arrival in the library")
	await reader_key(KEY_F2)
	check(game.mode==game.PICKER,"F2 returns to the test selector")
	print("DORI DISCOVERY: keyboard, mouse, optional observations, cancel, pause, save/resume, legacy routes and replay; failures: ",failures)
	quit(1 if failures else 0)
